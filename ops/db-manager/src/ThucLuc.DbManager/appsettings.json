{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Ops": {
    "MigrationSqlPath": "../../../../backend/db/flyway/sql",
    "BackupRootLinux": "/var/lib/thucluc-db-manager/backups",
    "BackupRootWindows": "D:\\ThucLucData\\DbBackups",
    "DataPumpExportVersion": "COMPATIBLE",
    "UseHttpsRedirection": false,
    "ProtectKeysWithDpapi": true,
    "RequireEncryptedDataProtectionKeys": false,
    "DataProtectionCertificatePath": "",
    "DataProtectionCertificatePasswordFile": "",
    "AllowProductionOperations": false,
    "ExecutionMode": "Ssh",
    "LocalDeployment": {
      "RootDirectory": "/opt/thucluc-test",
      "ComposeFile": "compose.yml",
      "EnvironmentFile": ".env",
      "BackendService": "backend",
      "FrontendService": "frontend",
      "GotenbergService": "gotenberg"
    },
    "Authentication": {
      "Enabled": false,
      "AdminUser": "admin",
      "PasswordHashFile": "/run/secrets/admin-password-hash",
      "SessionHours": 8
    },
    "SshKnownHostsPath": "",
    "SshConnectTimeoutSeconds": 10,
    "RemoteCommandTimeoutSeconds": 120,
    "LongRunningCommandTimeoutSeconds": 7200,
    "ArtifactUploadTimeoutSeconds": 1800,
    "DiskWarningPercent": 80,
    "Environments": [],
    "Hosts": []
  }
}
