#!/usr/bin/env bash

set -Eeuo pipefail
source /opt/thucluc-ops/lib/common.sh

version="${1:-}"
validate_version "$version"
require_command docker

app_dir=/opt/thucluc/infra
env_file="$app_dir/.env"
archive="$app_dir/releases/gotenberg-$version.tar"
new_image="thucluc-gotenberg:$version"
require_file "$app_dir/compose.yml"
require_file "$env_file"
require_file "$archive"

exec 9>/run/lock/thucluc-infra-update.lock
flock --exclusive 9

docker load --input "$archive"
docker image inspect "$new_image" >/dev/null
old_image="$(sed -n 's/^GOTENBERG_IMAGE=//p' "$env_file" | tail -n 1)"
if [[ -z "$old_image" ]]; then
  echo "Không tìm thấy GOTENBERG_IMAGE trong $env_file." >&2
  exit 3
fi

printf '%s\n' "$old_image" > "$app_dir/.gotenberg-previous-image"
set_env_value "$env_file" GOTENBERG_IMAGE "$new_image"
export GOTENBERG_IMAGE="$new_image"
if ! docker compose \
  --project-directory "$app_dir" \
  --env-file "$env_file" \
  --file "$app_dir/compose.yml" \
  up --detach --no-deps --wait gotenberg
then
  set_env_value "$env_file" GOTENBERG_IMAGE "$old_image"
  export GOTENBERG_IMAGE="$old_image"
  docker compose \
    --project-directory "$app_dir" \
    --env-file "$env_file" \
    --file "$app_dir/compose.yml" \
    up --detach --no-deps --wait gotenberg || true
  echo "Update Gotenberg lỗi; đã thử quay về image trước." >&2
  exit 5
fi

echo "Gotenberg đã chạy image $new_image."
