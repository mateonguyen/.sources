#!/usr/bin/env bash

set -Eeuo pipefail
source /opt/thucluc-ops/lib/common.sh

version="${1:-}"
validate_version "$version"
require_command docker

app_dir="$(resolve_component_app_dir backend)"
image="thucluc-backend:$version"
archive="$app_dir/releases/backend-$version.tar"
current_file="$(component_state_file "$app_dir" backend current)"
previous_file="$(component_state_file "$app_dir" backend previous)"

require_file "$app_dir/compose.yml"
require_file "$app_dir/.env"
require_file "$archive"

exec 9>/run/lock/thucluc-backend-deploy.lock
flock --exclusive 9

docker load --input "$archive"
docker image inspect "$image" >/dev/null

current_version=""
if [[ -f "$current_file" ]]; then
  current_version="$(tr -d '[:space:]' < "$current_file")"
elif current_version="$(detect_component_version "$app_dir" backend thucluc-backend)"; then
  :
fi

export THUCLUC_BACKEND_IMAGE="$image"
export RELEASE_VERSION="$version"
docker compose \
  --project-directory "$app_dir" \
  --env-file "$app_dir/.env" \
  --file "$app_dir/compose.yml" \
  up --detach --no-deps --wait backend

set_env_value "$app_dir/.env" THUCLUC_BACKEND_IMAGE "$image"
set_env_value "$app_dir/.env" RELEASE_VERSION "$version"

if [[ -n "$current_version" && "$current_version" != "$version" ]]; then
  printf '%s\n' "$current_version" > "$previous_file"
fi
printf '%s\n' "$version" > "$current_file"
echo "Backend đã chạy phiên bản $version."
