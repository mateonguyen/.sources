#!/usr/bin/env bash

set -Eeuo pipefail
source /opt/thucluc-ops/lib/common.sh

app_dir="$(resolve_component_app_dir backend)"
version="$(read_or_detect_component_version "$app_dir" backend thucluc-backend)"
export THUCLUC_BACKEND_IMAGE="thucluc-backend:$version"
export RELEASE_VERSION="$version"
docker compose \
  --project-directory "$app_dir" \
  --env-file "$app_dir/.env" \
  --file "$app_dir/compose.yml" \
  logs --no-color --tail 200 backend
