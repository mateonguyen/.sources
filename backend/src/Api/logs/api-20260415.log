    FETCH FIRST 1 ROWS ONLY), (
    SELECT "r4"."SUBMITTED_AT"
    FROM "CAND_QLCNTT"."RPT_BAO_CAO_SNAPSHOT" "r4"
    WHERE (("r4"."DELETED_AT" IS NULL) AND ((("r4"."KY_BAO_CAO_ID" = "r"."KY_BAO_CAO_ID") AND ("r4"."DON_VI_ID" = "r"."DON_VI_ID"))))
    ORDER BY "r4"."PHIEN_BAN" DESC
    FETCH FIRST 1 ROWS ONLY), (
    SELECT "r5"."LOCKED_AT"
