    WHERE (("r5"."DELETED_AT" IS NULL) AND ((("r5"."KY_BAO_CAO_ID" = "r"."KY_BAO_CAO_ID") AND ("r5"."DON_VI_ID" = "r"."DON_VI_ID"))))
    ORDER BY "r5"."PHIEN_BAN" DESC
    FETCH FIRST 1 ROWS ONLY), "r"."NGAY_MO_LAI", "r"."NGAY_XAC_NHAN"
FROM "CAND_QLCNTT"."RPT_KY_TRANG_THAI_DON_VI" "r"
INNER JOIN (
    SELECT "r0"."ID", "r0"."TEN_DON_VI"
    FROM "CAND_QLCNTT"."REF_DON_VI" "r0"
    WHERE "r0"."DELETED_AT" IS NULL
) "t" ON "r"."DON_VI_ID" = "t"."ID"
WHERE "r"."KY_BAO_CAO_ID" = :id_0
ORDER BY "t"."TEN_DON_VI"
